//we will use the following environment variable to store our Google Maps API key. 
//pls make sure to replace 'your_google_maps_api_key_here' with your actual API key when you create your .env file.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google OAuth 2.0 Web Client ID – required for the Google Calendar integration.
# Create one at https://console.cloud.google.com -> APIs & Services -> Credentials
# (Web application type; add https://auth.expo.io/@<owner>/<slug> as an authorized redirect URI).
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
